    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "prettier": "^2.8.8",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
