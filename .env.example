# EventOK web app. Every value here ships to the browser, so only public values belong here.
#
# There are no Supabase keys in the frontend on purpose: the browser talks only to the EventOK
# API, which reads/writes Supabase Postgres + Storage with its server-side key. Logins are Clerk;
# the API saves each signed-in user into the Supabase `users` table.

# EventOK API base URL (local: the eventok-be dev server; production: your deployed API).
VITE_API_BASE_URL=http://127.0.0.1:8100/api/v1
VITE_SOCKET_URL=http://127.0.0.1:8100
# Clerk Dashboard → Configure → API keys → Publishable key.
# Quote required: Clerk publishable keys end with "$"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace"
